# Copy this file to ".env" and fill in your own values.
# Never commit the real .env file to GitHub.

PORT=5000

# Local MongoDB server (the one Compass connects to as well):
MONGODB_URI=mongodb://127.0.0.1:27017/shotlist
# MongoDB Atlas example (replace user, password and cluster):
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/shotlist?retryWrites=true&w=majority

# A long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_me_with_a_long_random_string

# The address of the React app (used for CORS)
CLIENT_URL=http://localhost:5173

# development or production
NODE_ENV=development
